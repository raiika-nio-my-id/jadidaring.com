APP_NAME=Jadidaring
# APP_ENV=production on the server; local for development
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://admin.jadidaring.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Local: jadidaring.test / admin.jadidaring.test
# Production: jadidaring.com / admin.jadidaring.com
APP_BASE_DOMAIN=jadidaring.test
ADMIN_DOMAIN=admin.jadidaring.test
# Games are https://www.${APP_BASE_DOMAIN}/{subdomain}. GameHub is /gamehub.
# Leave GAMEHUB_HOST unset unless the proxy host changes. It is the public
# host for every game path, read when routes are registered. GET / on the
# apex and on www is the marketing homepage served by this app.
# GAMEHUB_HOST=www.jadidaring.test

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared MySQL from ~/project/infrastructure (container: mysql-db)
DB_CONNECTION=mysql
DB_HOST=mysql-db
DB_PORT=3306
DB_DATABASE=comprof_cms
DB_USERNAME=jadidaring_app
DB_PASSWORD=root

# Host-only admin cookie. Do NOT set SESSION_DOMAIN=.jadidaring.test
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_SECURE_COOKIE=false

# One Reverb process for every game. Nginx proxies /app and /apps on the
# public host (www), before PHP, so the browser websocket is not under
# /{subdomain}/app. REVERB_HOST is the Docker service name. Browsers use the
# public host from /api/game/config, not REVERB_HOST. Old subdomain /app
# upgrades still reach Reverb when that DNS name points at this nginx.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Published on the host for global-proxy → 127.0.0.1:APP_PORT
APP_PORT=8081

# Laravel Boost (dev-only package). These must be set in production to prevent
# the browser-log watcher script from being injected into client pages.
# BoostServiceProvider::shouldRun() already gates on environment=local OR
# APP_DEBUG=true, so setting APP_ENV=production + APP_DEBUG=false is
# sufficient. BOOST_BROWSER_LOGS_WATCHER=false is an additional hard guard.
# Also run: composer install --no-dev && php artisan config:cache
#BOOST_BROWSER_LOGS_WATCHER=false

# Fallback GM key when Settings → Gamemaster secret is empty or unset.
# Leave empty here; set a real value in the server .env only.
GAME_GAMEMASTER_SECRET=

# Machine-to-machine admin API on the admin host (POST/PATCH /api/admin/clients).
# Send as header: X-Admin-Api-Key: <secret>
# Generate a production value: openssl rand -hex 32
ADMIN_API_SECRET=

# Mail (Brevo SMTP). Password reset only works once these are set.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@jadidaring.com

# Social login. Each button appears only when its credentials are set.
# Callbacks: https://jadidaring.com/auth/google/callback, https://jadidaring.com/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Telegram: bot username (no @) and token; set the bot domain to jadidaring.com via BotFather /setdomain
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN=

# Google Analytics 4 (banner + gtag hidden when unset), e.g. G-XXXXXXXXXX
# GA4_MEASUREMENT_ID=
# News bot API uses ADMIN_API_SECRET (X-Admin-Api-Key header) on the admin host: /api/admin/news/*
